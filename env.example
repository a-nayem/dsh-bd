# Needed only for the "Change image" button on the Night Drive panel.
# Add these in Vercel (Project Settings > Environment Variables) and in .env.local for local dev.

# Fine-grained personal access token scoped to this one repo, permission: Contents (read and write)
GITHUB_TOKEN=

# Any long random string. The dashboard asks for it once per browser before it will push.
DASHBOARD_ADMIN_KEY=

# Optional, these are the defaults
# GITHUB_REPO=a-nayem/dsh-bd
# GITHUB_BRANCH=main
